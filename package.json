{
  "name": "@vanduo-oss/labs",
  "version": "0.1.1",
  "private": true,
  "description": "Vanduo Labs — demo playground for published VDL engines (hybrid search, AiChat, model-eval)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vanduo-oss/labs.git"
  },
  "keywords": [
    "vanduo",
    "labs",
    "demo",
    "hybrid-search",
    "ai-chat",
    "model-eval"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "demo:serve": "vite",
    "index": "node utils/hybrid-search-indexer.mjs",
    "models:fetch": "node utils/fetch-ai-models.mjs",
    "model-eval": "node utils/model-eval-runner.mjs",
    "lint": "eslint model-eval.js \"utils/**/*.{js,mjs}\" \"src/**/*.{js,mjs}\"",
    "format": "prettier --write \"model-eval.js\" \"utils/**/*.{js,mjs}\" \"src/**/*.{js,mjs,vue,css}\"",
    "format:check": "prettier --check \"model-eval.js\" \"utils/**/*.{js,mjs}\" \"src/**/*.{js,mjs,vue,css}\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:unit": "playwright test tests/unit",
    "test:local": "playwright test -c tests/local/playwright.config.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "prettier": "^3.6.2",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@litert-lm/core": "^0.15.0",
    "@vanduo-oss/vd3": "^1.3.0",
    "@vanduo-oss/vd3-cbun": "^1.3.2",
    "@vanduo-oss/vdl-ai-chat": "^0.1.1",
    "@vanduo-oss/vdl-hybrid-search": "^0.1.2",
    "fuse.js": "^7.3.0",
    "vue": "^3.5.41"
  }
}
